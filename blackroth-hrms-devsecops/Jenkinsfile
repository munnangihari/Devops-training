pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build') {
      steps { sh 'npm install --prefix backend' }
    }
    stage('Test') {
      steps { sh 'npm test --prefix backend' }
    }
    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQubeServer') {
          sh '''
            sonar-scanner \
              -Dsonar.projectKey=devops-training \
              -Dsonar.sources=backend \
              -Dsonar.host.url=http://localhost:9000 \
              -Dsonar.login=$SONARQUBE_TOKEN
          '''
        }
      }
    }
    stage('Docker Build & Push') {
      steps {
        script {
          docker.build("blackroth-hrms-backend:${BUILD_NUMBER}")
          // Add docker push to registry here
        }
      }
    }
  }
}

