pipeline {
    agent any

    stages {
        stage('Checkout') {
            options {
                // Retry checkout stage up to 2 times if Jenkins restarts
                retry(2)
            }
            steps {
                git branch: 'main', url: 'https://github.com/munnangihari/Devops-training.git'
            }
        }

        stage('Unit Tests') {
            steps {
                // Run tests inside slim Python container
                sh 'docker run --rm -v $PWD:/app -w /app python:3.11-slim bash -c "pip install -r application/requirements.txt && pytest tests/"'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t devops-week1-app .'
            }
        }

        stage('Deploy to EC2') {
            steps {
                // Use deploy.sh script for cleaner deployment
                sh 'ssh -o StrictHostKeyChecking=no ubuntu@<EC2_PUBLIC_IP> "cd ~/devops-week1-project && git pull && ./scripts/deploy.sh"'
            }
        }

        stage('Health Check') {
            steps {
                sh './scripts/health-check.sh'
            }
        }
    }
}

