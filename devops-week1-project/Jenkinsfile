pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/munnangihari/Devops-training.git'
            }
        }

        stage('Unit Tests') {
            steps {
                // Install dependencies using python3 -m pip
                sh 'python3 -m pip install -r application/requirements.txt'
                // Ensure pytest is installed
                sh 'python3 -m pip install pytest'
                // Run tests with python3 -m pytest
                sh 'python3 -m pytest tests/'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t devops-week1-app .'
            }
        }

        stage('Deploy to EC2') {
            steps {
                sh 'ssh -o StrictHostKeyChecking=no ubuntu@<EC2_PUBLIC_IP> "cd ~/devops-week1-project && git pull && docker build -t devops-week1-app . && docker run -d -p 80:8000 devops-week1-app"'
            }
        }

        stage('Health Check') {
            steps {
                sh './scripts/health-check.sh'
            }
        }
    }
}

